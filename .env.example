# Copia este archivo a .env (cp .env.example .env) y completa los valores.
# Para los ambientes desplegados el archivo es `.env.prod`, y se sube como secret
# de GitHub (gh secret set ENV_FILE < .env.prod), no al repo.
# Requiere las dependencias del proyecto: uv sync
#
# Todo lo que el codigo lee del entorno esta aca. Las que traen valor son el
# default real (dejarlas asi funciona); las vacias son opcionales o secretos, y
# cada bloque dice que se cae si falta. Los defaults viven en
# app/core/config.py — si agregas un campo alla, agregalo aca.

# ── docker compose ────────────────────────────────────────────────────────────
# Tag de la imagen que construye docker compose.
IMAGE=unergy-operaciones-backend:latest
# Puerto del servicio: uvicorn escucha ahi y docker compose publica el mismo
# numero en el host. Cambialo si el 8000 esta ocupado en el servidor.
PORT=8000
# WORKERS>1 duplica los jobs del BackgroundScheduler. Subirlo solo si se saca
# el scheduler del proceso web.
WORKERS=1

# ── Base de datos ─────────────────────────────────────────────────────────────
# En piezas, como el resto de los servicios de la casa. La app, Alembic y los
# scripts arman la URL desde aca (app/core/config.py::armar_database_url).
POSTGRES_DB=operaciones
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
# OJO desde el contenedor: `localhost` es el propio contenedor. Si el Postgres
# corre en el host, PG_HOST=host.docker.internal (el compose ya trae el
# extra_hosts que lo resuelve).
#
# Alternativa: si el proveedor entrega una URL de un solo pegue, ponla aca y
# GANA sobre las cinco de arriba. Acepta postgres:// y postgresql:// tal cual;
# se normaliza a postgresql+psycopg:// sola.
DATABASE_URL=

# ── App ───────────────────────────────────────────────────────────────────────
# Con ENVIRONMENT != development, un SECRET_KEY vacio ABORTA el arranque (los JWT
# se firmarian con "" y cualquiera podria forjar un token de admin).
SECRET_KEY=change-me-to-a-secure-random-string
JWT_EXPIRE_MINUTES=480
# Token largo para la PWA movil (30 dias).
MOBILE_JWT_EXPIRE_MINUTES=43200
# ENVIRONMENT la leen LOS DOS backends: FastAPI (app/core/config.py) y Django
# (config/settings.py, donde ademas decide DEBUG). No existe una variable ENV.
ENVIRONMENT=development
APP_NAME=Plataforma Operaciones Unergy
FRONTEND_URL=http://localhost:5173
TIMEZONE=America/Bogota

# ── Solo Django ───────────────────────────────────────────────────────────────
# Hosts que Django acepta en la cabecera Host. Solo se aplica con
# ENVIRONMENT=production (con DEBUG=True Django lo ignora). "*" acepta todo:
# sirve detras de un proxy que ya filtra, no de cara a internet.
ALLOWED_HOSTS=*
# Broker de Celery (config/celery.py). Todavia no hay ni tareas ni servicio
# worker en el compose; cuando los haya, esta es la variable.
CELERY_BROKER_URL=redis://localhost:6379/0

# Bases de otros servicios de Unergy, solo lectura, para /mapa. Vacias = ese
# endpoint responde sin esos datos.
ORIGINA_DATABASE_URL=
REQUESTSDB_DATABASE_URL=

# ── Almacenamiento de archivos ────────────────────────────────────────────────
# local = disco (STORAGE_LOCAL_PATH, montado como volumen en el compose).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
# Solo si STORAGE_BACKEND=s3.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── CRM comercial ─────────────────────────────────────────────────────────────
# Dias sin respuesta antes de alertar una oportunidad.
COMERCIAL_ALERTA_DIAS=5
# true reaplica la actualizacion comercial de julio 2026, PISANDO lo que se haya
# cambiado a mano despues. Se marca sola, asi que normalmente va en false.
COMERCIAL_REAPLICAR_ACTUALIZACION=false

# ── Unergy API (legacy bridge) ────────────────────────────────────────────────
# NO confundir con UNERGY_API_EMAIL/PASS de abajo (esas son para los scripts de carga).
UNERGY_API_URL=https://api.unergy.io
UNERGY_ACCOUNT_ID=
UNERGY_LOGIN=
UNERGY_PASSWORD=

# API de Liquidaciones (mismo host que UNERGY_API_URL). La cuenta debe estar en
# el grupo `admin` Y tener is_staff=True. Si se dejan vacías se usan UNERGY_*.
LIQUIDACIONES_LOGIN=
LIQUIDACIONES_PASSWORD=
# Clave de Gemini con la que la API lee los PDF de las facturas de XM.
# Opcional: vacía = esa API usa la suya.
LIQUIDACIONES_GEMINI_API_KEY=

# Credenciales para los SCRIPTS DE CARGA hand-invoked (scripts/cargar_*.py,
# reconciliar_*.py, migrate_fallas_desde_sheets.py). Las leen vía scripts/_creds.py.
# Es el login (email + password) de un usuario de la plataforma de operaciones.
UNERGY_API_EMAIL=
UNERGY_API_PASS=

# Contraseña inicial de los usuarios sembrados por app/seeds/seed_data.py.
# Cámbiala antes de sembrar en cualquier entorno real; los usuarios deben rotarla.
SEED_USER_PASSWORD=changeme123

# ── Solenium / SunFactory / SolarView ─────────────────────────────────────────
# Solenium API (datos de inversores, FMO).
SOLENIUM_AUTH_URL=https://auth.sole.tech/api
SOLENIUM_DATA_URL=https://data.sole.tech/api
SOLENIUM_USER=
SOLENIUM_PASS=
# SunFactory: cronogramas de construccion (proximos a energizarse).
SUNFACTORY_API_URL=https://sunfactory.sole.tech/api
SUNFACTORY_AUTH_URL=https://auth.sole.tech/api/token/
SUNFACTORY_USERNAME=
SUNFACTORY_PASSWORD=
# SolarView: reemplazo de Solenium (Fase 1, solo Reporte de Energia). Token
# estatico por header, sin login.
SOLARVIEW_BASE_URL=https://api.sole.tech
SOLARVIEW_TOKEN=

# ── Quoia / Gaia (fronteras y medidores CGM) ──────────────────────────────────
QUOIA_BASE_URL=https://gaia.quoia.energy/api
QUOIA_API_TOKEN=
GAIA_BASE_URL=https://gaia.quoia.energy
GAIA_USER=
GAIA_PASS=

# ── EVO Energy (DailySpot + clima, via Tailscale) ─────────────────────────────
EVO_API_URL=
EVO_API_TOKEN=

# ── Monitoreo MGS (polling de alarmas) ────────────────────────────────────────
MGS_ENABLED=true
MGS_POLL_INTERVAL_MINUTES=15

# ── Correo ────────────────────────────────────────────────────────────────────
# SMTP (opcional): sin esto no salen informes ni alertas por correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=operaciones@unergy.io
# BCC del Reporte CGM (lista separada por comas).
CORREO_SEGUIMIENTO=
# Un solo correo que recibe aviso cuando CUALQUIER envio falla. A proposito
# distinto de CORREO_SEGUIMIENTO/SMTP_FROM: debe ser una bandeja que alguien
# revise, no la operativa que puede ser justo la que esta fallando.
ALERTA_FALLOS_EMAIL=

# IMAP — lectura de correos entrantes (Excel de terceros). Reusa
# SMTP_USER/SMTP_PASSWORD; IMAP tiene que estar habilitado en esa cuenta.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP de mandatos: buzon adhara@unergy.io, cuenta distinta de operaciones@, con
# su propio App Password.
MANDATOS_IMAP_USER=
MANDATOS_IMAP_PASSWORD=
# Segundo buzon, opcional: parte del correo de mandatos no pasa por adhara@.
# Vacio = se lee uno solo, con menos cobertura en la reconciliacion.
MANDATOS_IMAP_USER_2=
MANDATOS_IMAP_PASSWORD_2=

# ── Alertas de contratos PPA ──────────────────────────────────────────────────
# Job diario 08:15 America/Bogota. Dias de antelacion (lista separada por comas).
PPA_ALERT_DAYS=90,60,30

# ── Google Drive ──────────────────────────────────────────────────────────────
# Estas NO pasan por app/core/config.py: se leen con os.environ donde se usan.
# JSON de la cuenta de servicio (contenido completo, en una linea). Sin esto,
# subir evidencia a Drive devuelve 500.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Carpetas destino. Vacias = se usan los IDs por defecto del codigo.
DRIVE_MANDATOS_FOLDER_ID=
DRIVE_ER_FOLDER_ID=

# Cache local de los archivos de XM (app/services/xm/cache_local.py). Vacio =
# ruta por defecto del codigo.
XM_CACHE_DIR=

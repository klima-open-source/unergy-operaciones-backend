# Copia este archivo a ".env" (en esta misma carpeta) si quieres elegir
# tu propia carpeta de caché de archivos XM. Si no lo creas, cada
# persona recibe un default razonable según su usuario de Windows.
XM_CACHE_DIR=C:\Users\tu_usuario\Documentos\Xm\Archivos_Filezilla

# Dirección del front desplegado, la que sale en la barra del navegador.
# Solo hace falta para usar la pestaña desde la plataforma desplegada:
# cualquier localhost ya está permitido sin configurar nada. Varias, con coma.
XM_ORIGENES_EXTRA=https://unergy-operaciones.xxx.workers.dev
